# Content-hashed by Next, so immutable is safe.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Sized copies made by scripts/build-card-images.mjs. The name carries a hash of the
# source photo, so immutable is safe.
/img/*
  Cache-Control: public, max-age=31536000, immutable

# Home's hero loop and its posters. Each name carries the first 8 hex characters of the
# source clip's sha256, so immutable is safe: a new clip must get new names.
/video/*
  Cache-Control: public, max-age=31536000, immutable

# The four folders below hold files under plain names, so they must NOT be immutable:
# a photo replaced under the same name would keep serving the old copy for a year.
# A day in the browser, then served stale for up to a week while it revalidates.
/Products/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# Hashed by scripts/externalize-flight.mjs, so immutable is safe.
/_flight/*
  Cache-Control: public, max-age=31536000, immutable

# The service worker. Browsers ask for it on every page load to see whether it changed;
# no-cache makes that reach Cloudflare each time, so a fix or the kill switch lands on
# the next visit. Never immutable or a long max-age, and never delete the file (see the
# header of public/sw.js).
/sw.js
  Cache-Control: no-cache

# The icon sprite, named by its content hash (scripts/build-icons.mjs), so immutable is safe.
/icons/*
  Cache-Control: public, max-age=31536000, immutable

/lovable-uploads/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/logos/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/Services/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# App Router emits per-route RSC flight payloads as .txt alongside the HTML.
# Keep them out of the index -- they would read as thin duplicate content.
/*.txt
  X-Robots-Tag: noindex
# Note: Cloudflare's * crosses /, so this also matches /robots.txt. That is
# harmless -- X-Robots-Tag governs indexing, not fetching, and robots.txt is
# never indexed while still being fully honoured. Do not try to override it with
# a more specific /robots.txt rule: Cloudflare Pages CONCATENATES same-name
# headers rather than replacing them, which yields "noindex, all".

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Cross-Origin-Opener-Policy: same-origin-allow-popups
