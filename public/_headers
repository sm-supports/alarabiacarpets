# Content-hashed by Next, so immutable is safe.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

/Products/*
  Cache-Control: public, max-age=31536000, immutable

/lovable-uploads/*
  Cache-Control: public, max-age=31536000, immutable

/logos/*
  Cache-Control: public, max-age=31536000, immutable

# App Router emits per-route RSC flight payloads as .txt alongside the HTML.
# Keep them out of the index -- they would read as thin duplicate content.
/*.txt
  X-Robots-Tag: noindex
# Note: Cloudflare's * crosses /, so this also matches /robots.txt. That is
# harmless -- X-Robots-Tag governs indexing, not fetching, and robots.txt is
# never indexed while still being fully honoured. Do not try to override it with
# a more specific /robots.txt rule: Cloudflare Pages CONCATENATES same-name
# headers rather than replacing them, which yields "noindex, all".

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
